# Dify workflow endpoint
DIFY_BASE_URL=http://dify.ads.qihoo.net/v1
# Bearer API key for the workflow app (get from Dify → 该应用 → API 访问)
DIFY_API_KEY=
# Total seconds to wait for a blocking workflow run before timing out.
DIFY_TIMEOUT=300
# Where to store run records, relative to this directory.
RUNS_DIR=runs
