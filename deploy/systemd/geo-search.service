[Unit]
Description=GEO web_search / web_fetch service (search_server.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=geopress
Group=geopress
WorkingDirectory=/opt/geo-presales-skills
EnvironmentFile=/etc/geo-presales/env
ExecStart=/opt/geo-presales-venv/bin/python /opt/geo-presales-skills/search_server.py --host 127.0.0.1 --port 9998
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
