[Unit]
Description=GEO Orchestrator (platforms/geo-orchestrator, FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=geopress
Group=geopress
WorkingDirectory=/opt/geo-presales-skills/platforms/geo-orchestrator
EnvironmentFile=/etc/geo-presales/env
Environment=RUNS_DIR=/var/lib/geo-orchestrator/runs
ExecStart=/opt/geo-presales-venv/bin/uvicorn app:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/geo-orchestrator

[Install]
WantedBy=multi-user.target
