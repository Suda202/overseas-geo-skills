# 复制到 /etc/geo-presales/env 后填写（chmod 600 root:root）
# 密钥禁止写入仓库，systemd 通过 EnvironmentFile 注入

# --- Scrapeless（server.py 与 search_server.py 共用）---
SCRAPELESS_API_KEY=
SCRAPELESS_BASE_URL=https://api.scrapeless.com

# --- Dify（仅 platforms/geo-orchestrator 需要）---
# 注意：默认值指向公司内网，公网服务器通常无法访问，见 deploy/README.md
DIFY_BASE_URL=http://dify.ads.qihoo.net/v1
DIFY_API_KEY=
DIFY_TIMEOUT=300

# --- 对外访问令牌（nginx 层校验，三个服务共用）---
# 生成：openssl rand -hex 32
GEO_ACCESS_TOKEN=
